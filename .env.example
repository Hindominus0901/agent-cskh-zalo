# Chep file nay thanh `.env` roi dien vao. KHONG BAO GIO commit file `.env`.
#
#   Windows:  Copy-Item .env.example .env
#   macOS:    cp .env.example .env
#
# Chay `uv run agent-cskh check` de biet con thieu gi.

# ============ CHE DO ============
# tra_cuu = 0 dong, KHONG can API key. Bot tra loi bang cach tim trang trong
#           kho tri thuc. Khong hieu ngu canh nhieu luot, khong suy luan —
#           nhung dung duoc ngay va khong ton mot dong nao.
# ai      = dung Claude. Thong minh hon han, ton khoang $2-3/thang o muc kich
#           tran 3.000 tin Zalo. Can ANTHROPIC_API_KEY.
#
# Bat dau bang `tra_cuu`. Doi sang `ai` khi da co kho tri thuc tu te — cung mot
# kho, khong phai lam lai gi ca.
CHE_DO=tra_cuu

# ============ ZALO ============
# De trong thi bot van chay duoc bang `uv run agent-cskh chat` (chat ngay trong
# terminal). Chi can token khi muon dua bot len Zalo that.
#
# LAY TOKEN — khoang 5 phut, KHONG phai cho duyet:
#   1. Mo app Zalo, tim Official Account "Zalo Bot Manager"
#   2. Trong khung chat chon "Tao bot" -> mo app Zalo Bot Creator
#   3. Dat ten bot BAT DAU BANG CHU "Bot" (vd: Bot Gac Nho)
#   4. Zalo NHAN TIN cho ban kem token, dang <so>:<chuoi>
#
# Dung tai khoan Zalo ca nhan la duoc — KHONG can OA doanh nghiep. Chi tiet va
# cac buoc con lai: docs/01-noi-zalo.md
ZALO_BOT_TOKEN=
ZALO_API_BASE=https://bot-api.zaloplatforms.com
TRANSPORT=polling
# Chi dung khi TRANSPORT=webhook
WEBHOOK_URL=
WEBHOOK_SECRET=

# Han muc goi Basic: 3000 tin/thang, 50 nguoi dung/bot. Xem docs/02-gioi-han-zalo.md
ZALO_MONTHLY_QUOTA=3000
QUOTA_WARN_PCT=80
QUOTA_HARD_PCT=95

# ============ AI (chi can khi CHE_DO=ai) ============
# Lay key tai console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Tran cung theo ngay. Cham tran thi bot tu ha xuong muc re, khong tu dung.
DAILY_COST_LIMIT_USD=2.0

# ============ QUYEN ============
# user_id Zalo cua chu bot, cach nhau bang dau phay. Lay bang cach nhan /whoami
# cho bot sau khi no chay.
OWNER_USER_IDS=
# chat_id nhan canh bao. DUNG dat vao nhom co khach hang: canh bao kem ten
# khach va chat_id cua ho. Dat bang lenh /datkenhcanhbao trong chat rieng.
ALERT_CHAT_ID=

# ============ HARNESS ============
MAX_ITERATIONS=8
TURN_TIMEOUT=180
LLM_TIMEOUT=90
TOOL_TIMEOUT=30
MAX_REPLY_CHARS=2000
MAX_CONCURRENT_TURNS=8
RATE_LIMIT_PER_MIN=12

# ============ VAN HANH ============
LOG_LEVEL=INFO
LOG_JSON=false
TIMEZONE=Asia/Ho_Chi_Minh
